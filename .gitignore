# =============================================================================
# SipLens — .gitignore
# Keep: source code, specs/docs, contracts, Spec Kit config & templates.
# Exclude: AI tooling, local state, generated artifacts, OS/editor files.
# =============================================================================


# -----------------------------------------------------------------------------
# AI Agent tooling (Antigravity / Gemini IDE)
# Not part of the project — local to each developer's machine.
# -----------------------------------------------------------------------------
.gemini/


# -----------------------------------------------------------------------------
# Spec Kit — tooling and documentation
# Both .specify/ (tooling) and specs/ (feature docs) are local developer
# workflow artifacts and should not be shared via the repository.
# -----------------------------------------------------------------------------
.specify/
specs/


# -----------------------------------------------------------------------------
# Node / React Native / Expo
# (ready for when the RN project is initialised inside this repo)
# -----------------------------------------------------------------------------
node_modules/
.expo/
.expo-shared/
dist/
build/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
web-build/

# Metro bundler cache
.metro-health-check*
metro-cache/

# Expo / EAS
.easignore
eas.json.local


# -----------------------------------------------------------------------------
# Environment & secrets
# Never commit credentials or environment-specific config.
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
*.secret
google-services.json
GoogleService-Info.plist


# -----------------------------------------------------------------------------
# OS-generated files
# -----------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db


# -----------------------------------------------------------------------------
# Editor / IDE
# -----------------------------------------------------------------------------

# VSCode — keep workspace settings (.vscode/extensions.json etc.), exclude local overrides
.vscode/settings.json
.vscode/launch.json
.vscode/*.code-workspace

# JetBrains / Rider
.idea/
*.iml

# Vim / Emacs swap files
*.swp
*.swo
*~


# -----------------------------------------------------------------------------
# TypeScript build output
# (specs/*.ts are source contracts — NOT compiled, so no outDir to ignore here)
# -----------------------------------------------------------------------------
*.tsbuildinfo
tsconfig.tsbuildinfo


# -----------------------------------------------------------------------------
# Logs & diagnostics
# -----------------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*


# -----------------------------------------------------------------------------
# Test coverage & reports
# -----------------------------------------------------------------------------
coverage/
.nyc_output/
test-results/
playwright-report/
